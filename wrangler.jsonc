{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "handledmoney-staging",
	"compatibility_date": "2026-10-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"main": ".open-next/worker.js",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		},
		"issues": {
			"enabled": true
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "handledmoney-staging"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "dc3cc93774664cc6ac02aafe91f4e201"
		}
	]
}
